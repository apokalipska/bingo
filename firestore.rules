rules_version = '2';

// Reguły dopasowane do małej, zaufanej grupy (do ~20 osób).
// Do samych danych appki (poza kontem pierwszego admina) dopuszczeni są
// tylko ludzie, których e-mail jest wpisany do kolekcji `allowlist` przez
// admina. Pierwsza osoba, która się kiedykolwiek zaloguje, zostaje adminem
// i automatycznie trafia na tę listę — nie trzeba nic ręcznie ustawiać
// w konsoli.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // dozwolony, jeśli e-mail jest na liście zaproszonych, albo jest jeszcze
    // zupełnie pierwszą osobą w appce (bootstrap pierwszego admina)
    function isAllowed() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email)) ||
        get(/databases/$(database)/documents/meta/stats).data.userCount == 0
      );
    }

    // licznik użytkowników, używany tylko do wykrycia "kto jest pierwszy"
    match /meta/stats {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // lista dozwolonych adresów e-mail — zarządza nią wyłącznie admin
    match /allowlist/{emailId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAllowed();

      allow create: if isAllowed() && request.auth.uid == userId && (
        request.resource.data.isAdmin == false ||
        (request.resource.data.isAdmin == true &&
         get(/databases/$(database)/documents/meta/stats).data.userCount == 0)
      );

      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.isAdmin == resource.data.isAdmin) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /phrases/{phraseId} {
      allow read: if isAllowed();
      allow create: if isAllowed() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isAllowed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAllowed() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAllowed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /wins/{winId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
