rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    function isFirstEver() {
      return !exists(/databases/$(database)/documents/meta/stats) ||
        get(/databases/$(database)/documents/meta/stats).data.userCount == 0;
    }

    function isAllowed() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/allowlist/$(request.auth.token.email)) ||
        isFirstEver()
      );
    }

    match /meta/stats {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /allowlist/{emailId} {
      allow read: if isAdmin();
      allow write: if isAdmin() || (isFirstEver() && emailId == request.auth.token.email);
    }

    match /users/{userId} {
      allow read: if isAllowed();

      allow create: if isAllowed() && request.auth.uid == userId && (
        request.resource.data.isAdmin == false ||
        (request.resource.data.isAdmin == true && isFirstEver())
      );

      allow update: if isSignedIn() && (
        (request.auth.uid == userId && request.resource.data.isAdmin == resource.data.isAdmin) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    match /phrases/{phraseId} {
      allow read: if isAllowed();
      allow create: if isAllowed() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /cards/{cardId} {
      allow read: if isAllowed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAllowed() && (request.resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isAllowed() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /wins/{winId} {
      allow read: if isAllowed();
      allow create: if isAllowed() && request.resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }
  }
}
